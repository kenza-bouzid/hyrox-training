{
  "name": "HYROX Coach",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "HYROX Coach",
      "protocol": "http",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": [
    "/bin/bash",
    "-lc",
    "PUBLIC_URL=\"https://${CODESPACE_NAME}-8000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}\" ALLOWED_HOSTS=\"${CODESPACE_NAME}-8000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev},localhost:8000,127.0.0.1:8000\" nohup python3 server.py --host 0.0.0.0 --port 8000 > /tmp/hyrox-coach.log 2>&1 &"
  ]
}
